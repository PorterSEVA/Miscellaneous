<!DOCTYPE html>
<!-- By Ion-o-koji -->
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>AI Chatbot v5</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg: #0b000a;
      --surface: #0a0a1a;
      --surface-elevated: #1a141a;
      --border: #1f1f1f;
      --text: #ffffff;
      --text-secondary: #888888;
      --accent: #8b5cf6;
      --accent-glow: rgba(139, 92, 246, 0.4);
      --user-bubble: #8b5cf6;
      --ai-bubble: #1f1f1f;
      --success: #22c55e;
      --danger: #dc2626;
    }

    html {
      height: -webkit-fill-available;
    }

    body {
      height: 100vh;
      height: 100dvh;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    .app {
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      max-width: 100%;
      margin: 0 auto;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .header-title {
      flex: 1;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
    }

    .menu-btn {
      width: 32px;
      height: 32px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    .menu-btn:hover {
      border-color: var(--accent);
      background: rgba(139, 92, 246, 0.1);
    }

    .settings-panel {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 320px;
      background: var(--surface);
      border-left: 1px solid var(--border);
      z-index: 2000;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }

    .settings-panel.open {
      transform: translateX(0);
    }

    .settings-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      display: none;
    }

    .settings-overlay.open {
      display: block;
    }

    .settings-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .settings-header h2 {
      font-size: 18px;
      font-weight: 600;
    }

    .close-btn {
      width: 28px;
      height: 28px;
      background: transparent;
      border: none;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .close-btn:hover {
      color: var(--accent);
    }

    .settings-content {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
    }

    .setting-group {
      margin-bottom: 20px;
    }

    .setting-label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 8px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .setting-value {
      display: block;
      font-size: 14px;
      color: var(--text);
      margin-bottom: 8px;
      font-weight: 500;
    }

    .slider-input {
      width: 100%;
      height: 4px;
      border-radius: 2px;
      background: var(--border);
      outline: none;
      -webkit-appearance: none;
      appearance: none;
    }

    .slider-input::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      transition: background 0.2s;
    }

    .slider-input::-webkit-slider-thumb:hover {
      background: #a855f7;
    }

    .slider-input::-moz-range-thumb {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      border: none;
      transition: background 0.2s;
    }

    .slider-input::-moz-range-thumb:hover {
      background: #a855f7;
    }

    .number-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
    }

    .number-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .textarea-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-family: inherit;
      resize: vertical;
      min-height: 80px;
      max-height: 150px;
    }

    .textarea-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .select-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      cursor: pointer;
    }

    .select-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .select-input option {
      background: var(--surface);
      color: var(--text);
    }

    .clear-btn {
      width: 100%;
      padding: 10px 16px;
      background: var(--danger);
      border: none;
      border-radius: 6px;
      color: white;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 10px;
    }

    .clear-btn:hover {
      background: #b91c1c;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #8b5cf6, #a855f7);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    .logo-text {
      font-size: 16px;
      font-weight: 600;
    }

    .badge {
      font-size: 11px;
      padding: 4px 10px;
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
      border-radius: 20px;
      font-weight: 500;
    }

    .chat-container {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      scroll-behavior: smooth;
    }

    .welcome {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      margin-top: 100px;
      align-items: center;
      min-height: 60vh;
      text-align: center;
      padding: 20px;
    }

    .welcome-icon {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, #8b5cf6, #a855f7);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin-bottom: 20px;
      box-shadow: 0 0 40px var(--accent-glow);
    }

    .welcome-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .welcome-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 24px;
    }

    .suggestions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      max-width: 320px;
    }

    .suggestion {
      padding: 12px 16px;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      margin: 5px;
    }

    .suggestion:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    .messages {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .message {
      display: flex;
      gap: 10px;
      animation: fadeIn 0.2s ease;
      align-items: flex-end;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      flex-direction: row-reverse;
    }

    .message-avatar {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
    }

    .message.user .message-avatar {
      background: var(--user-bubble);
    }

    .message.ai .message-avatar {
      background: var(--ai-bubble);
      border: 1px solid var(--border);
    }

    .message-content {
      max-width: calc(100% - 40px);
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 14px;
      line-height: 1.5;
      word-wrap: break-word;
      position: relative;
      white-space: pre-wrap;
      padding-right: 14px;
    }

    .message.user .message-content {
      background: var(--user-bubble);
      border-bottom-right-radius: 4px;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content {
      background: var(--ai-bubble);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content pre {
      background: #0a0a0a;
      padding: 10px;
      border-radius: 6px;
      overflow-x: auto;
      margin: 8px 0;
      font-family: 'SF Mono', monospace;
      font-size: 12px;
      position: relative;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content code {
      background: #0a0a0a;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: 'SF Mono', monospace;
      font-size: 12px;
    }

    .copy-button {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid var(--accent);
      color: var(--accent);
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s;
      z-index: 10;
      -webkit-user-select: none;
      user-select: none;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.7;
      flex-shrink: 0;
    }

    .copy-button:active {
      opacity: 1;
    }

    .code-wrapper {
      position: relative;
      background: #0a0a0a;
      border-radius: 6px;
      margin: 8px 0;
      padding: 10px;
      padding-top: 40px;
      overflow: hidden;
    }

    .code-wrapper code {
      display: block;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .code-copy-button {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid var(--accent);
      color: var(--accent);
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s;
      z-index: 10;
      -webkit-user-select: none;
      user-select: none;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.7;
      flex-shrink: 0;
    }

    .code-copy-button:active {
      opacity: 1;
    }

    .message-actions {
      display: none;
      gap: 4px;
      position: absolute;
      bottom: -35px;
      left: 0;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px;
      z-index: 10;
      width: max-content;
    }

    .message:hover .message-actions {
      display: flex;
    }

    .message.user .message-actions {
      left: auto;
      right: 0;
    }

    .action-btn {
      background: transparent;
      border: none;
      color: var(--accent);
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      transition: all 0.2s;
      white-space: nowrap;
      -webkit-user-select: none;
      user-select: none;
    }

    .action-btn:active {
      background: rgba(139, 92, 246, 0.2);
    }

    .action-btn.delete {
      color: var(--danger);
    }

    .action-btn.delete:active {
      background: rgba(220, 38, 38, 0.2);
    }

    .typing {
      display: flex;
      gap: 3px;
      padding: 4px 0;
    }

    .typing-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      animation: bounce 1.4s infinite;
    }

    .typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes bounce {

      0%,
      60%,
      100% {
        transform: translateY(0);
      }

      30% {
        transform: translateY(-6px);
      }
    }

    .input-area {
      padding: 12px 16px;
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
      background: var(--surface);
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    .input-wrapper {
      display: flex;
      gap: 10px;
      align-items: flex-end;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 8px 8px 8px 16px;
    }

    .input-wrapper:focus-within {
      border-color: var(--accent);
    }

    .chat-input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 14px;
      resize: none;
      max-height: 100px;
      min-height: 20px;
      outline: none;
      font-family: inherit;
      padding: 4px 0;
      margin: auto 0;
      display: block;
      width: 100%;
    }

    .chat-input::placeholder {
      color: var(--text-secondary);
    }

    .button-group {
      display: flex;
      gap: 8px;
    }

    .send-btn,
    .stop-btn {
      width: 32px;
      height: 32px;
      border: none;
      border-radius: 50%;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    .send-btn {
      background: var(--accent);
    }

    .send-btn:active:not(:disabled) {
      background: #7c3aed;
      transform: scale(1.05);
    }

    .send-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .stop-btn {
      background: var(--danger);
      display: none;
    }

    .stop-btn.show {
      display: flex;
    }

    .stop-btn:active {
      background: #b91c1c;
      transform: scale(1.05);
    }

    .send-btn svg,
    .stop-btn svg {
      width: 16px;
      height: 16px;
    }

    .toast {
      position: fixed;
      bottom: 80px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #dc2626;
      color: white;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13px;
      opacity: 0;
      transition: all 0.3s;
      z-index: 1000;
      pointer-events: none;
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .toast.success {
      background: var(--success);
    }

    .api-keys-section {
      margin-top: 40px;
    }

    .api-keys-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    .api-keys-table tr {
      border-bottom: 1px solid var(--border);
    }

    .api-keys-table td {
      padding: 12px 8px;
      font-size: 12px;
    }

    .api-keys-table td:first-child {
      text-align: left;
      color: var(--text);
      font-weight: 500;
      width: 50%;
    }

    .api-keys-table td:last-child {
      text-align: left;
      color: var(--text-secondary);
      font-size: 11px;
      width: 50%;
    }

    .status-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--text-secondary);
      margin-right: 6px;
      vertical-align: middle;
    }

    .status-indicator.active {
      background: var(--success);
      box-shadow: 0 0 6px var(--success);
    }

    .status-indicator.error {
      background: var(--danger);
      box-shadow: 0 0 6px var(--danger);
    }

    @media (min-width: 768px) {
      body {
        background: #0a0a0a;
      }

      .app {
        max-width: 800px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
      }

      .send-btn:hover:not(:disabled) {
        background: #7c3aed;
        transform: scale(1.05);
      }

      .stop-btn:hover {
        background: #b91c1c;
        transform: scale(1.05);
      }

      .action-btn:hover {
        background: rgba(139, 92, 246, 0.2);
      }

      .action-btn.delete:hover {
        background: rgba(220, 38, 38, 0.2);
      }

      .copy-button:hover {
        opacity: 1;
      }

      .code-copy-button:hover {
        opacity: 1;
      }
    }

    .hidden {
      display: none !important;
    }

  </style>
</head>

<body>
  <div class="app">
    <header class="header">
      <div></div>
      <div class="header-title">Chat Assistant - Gemini</div>
      <button class="menu-btn" id="menuBtn" title="Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="chat-container" id="chatContainer">
      <div class="welcome" id="welcome">
        <h1 class="welcome-title">How can I help you?</h1>
        <div class="suggestions">
          <button class="suggestion" onclick="setInput('How do I fix this code in JavaScript: ')">
            How do I fix this code in JavaScript:
          </button>
          <button class="suggestion" onclick="setInput('In this code in JavaScript it wont * how do I fix it here is the code: ')">
            In this code in JavaScript it wont * how do I fix it:
          </button>
          <button class="suggestion" onclick="setInput('In JavaScript how do I ')">
            In JavaScript how do I
          </button>
          <button class="suggestion" onclick="setInput('In JavaScript how dose this work: ')">
            In JavaScript how dose this work:
          </button>
          <button class="suggestion" onclick="setInput('Translate this sentence into Khmer: ')">
            Translate this sentence into Khmer:
          </button>
          <button class="suggestion" onclick="setInput('Translate this sentence into English: ')">
            Translate this sentence into English:
          </button>
        </div>
      </div>
      <div class="messages hidden" id="messages"></div>
    </div>

    <div class="input-area">
      <div class="input-wrapper">
        <textarea class="chat-input" id="chatInput" placeholder="Message..." rows="1"></textarea>
        <div class="button-group">
          <button class="send-btn" id="sendBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </button>
          <button class="stop-btn" id="stopBtn" title="Stop">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="6" width="12" height="12"></rect>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="settings-overlay" id="settingsOverlay"></div>
  <div class="settings-panel" id="settingsPanel">
    <div class="settings-header">
      <h2>Settings</h2>
      <button class="close-btn" id="closeSettingsBtn">&times;</button>
    </div>
    <div class="settings-content">
      <div class="setting-group">
        <label class="setting-label">System Prompt</label>
        <textarea id="systemPrompt" class="textarea-input" placeholder="Enter system instructions for the AI..."></textarea>
      </div>

      <div class="setting-group">
        <label class="setting-label">Conversation Presets</label>
        <select id="presets" class="select-input">
          <option value="none">Select a preset...</option>
          <option value="default">Default Assistant</option>
          <option value="teacher">Brilliant Teacher</option>
          <option value="developer">Expert Developer</option>
          <option value="engineer">Fact-Driven Engineer</option>
          <option value="religion">Religious Expert</option>
          <option value="creative">Creative Visionary</option>
          <option value="professional">Professional Advisor</option>
          <option value="analyst">Data Analyst</option>
          <option value="tutor">Patient Tutor</option>
        </select>
      </div>

      <div class="setting-group">
        <label class="setting-label">Temperature</label>
        <div class="setting-value" id="tempValue">0.7</div>
        <input type="range" id="temperature" class="slider-input" min="0" max="2" step="0.1" value="0.7">
      </div>

      <div class="setting-group">
        <label class="setting-label">Max Output Tokens</label>
        <input type="number" id="maxTokens" class="number-input" min="256" max="8192" value="2048">
      </div>

      <button class="clear-btn" id="clearChatBtn">Clear All Messages</button>

      <div class="setting-group api-keys-section">
        <label class="setting-label">API Keys Management</label>
        <table class="api-keys-table" id="apiKeysTable">
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const chatContainer = document.getElementById('chatContainer');
    const welcome = document.getElementById('welcome');
    const messages = document.getElementById('messages');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const stopBtn = document.getElementById('stopBtn');
    const menuBtn = document.getElementById('menuBtn');
    const settingsPanel = document.getElementById('settingsPanel');
    const settingsOverlay = document.getElementById('settingsOverlay');
    const closeSettingsBtn = document.getElementById('closeSettingsBtn');
    const clearChatBtn = document.getElementById('clearChatBtn');
    const toast = document.getElementById('toast');
    const systemPromptInput = document.getElementById('systemPrompt');
    const temperatureSlider = document.getElementById('temperature');
    const tempValue = document.getElementById('tempValue');
    const maxTokensInput = document.getElementById('maxTokens');
    const apiKeysTable = document.getElementById('apiKeysTable');
    const presetsSelect = document.getElementById('presets');

    const API_KEY_1 = '';
    const API_KEY_2 = '';
    const API_KEY_3 = '';
    const API_KEY_4 = '';
    const API_KEY_5 = '';
    const API_KEY_6 = '';
    const API_KEY_7 = '';
    const API_KEY_8 = '';
    const API_KEY_9 = '';
    const API_KEY_10 = '';

    const API_KEYS = [API_KEY_1, API_KEY_2, API_KEY_3, API_KEY_4, API_KEY_5, API_KEY_6, API_KEY_7, API_KEY_8, API_KEY_9, API_KEY_10].filter(k => k && k.trim() !== '');

    let currentKeyIndex = 0;
    let keyStatuses = {};
    let attemptedKeysThisCycle = new Set();
    let hasCheckedAllKeysThisCycle = false;
    let isStreamingResponse = false;
    let abortController = null;

    function loadCurrentKeyIndex() {
      const saved = localStorage.getItem('currentKeyIndex');
      if (saved) {
        currentKeyIndex = parseInt(saved);
        if (currentKeyIndex >= API_KEYS.length) {
          currentKeyIndex = 0;
        }
      } else {
        currentKeyIndex = 0;
      }
      renderApiKeyStatus();
    }

    function saveCurrentKeyIndex() {
      localStorage.setItem('currentKeyIndex', currentKeyIndex.toString());
    }

    function adjustTextareaHeight() {
      chatInput.style.height = 'auto';
      const scrollHeight = chatInput.scrollHeight;
      chatInput.style.height = Math.min(scrollHeight, 100) + 'px';
    }

    function resetTextareaHeight() {
      chatInput.style.height = '20px';
    }

    chatInput.addEventListener('input', adjustTextareaHeight);

    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const start = chatInput.selectionStart;
        const end = chatInput.selectionEnd;
        chatInput.value = chatInput.value.substring(0, start) + '\n' + chatInput.value.substring(end);
        chatInput.selectionStart = chatInput.selectionEnd = start + 1;
        adjustTextareaHeight();
      } else if (e.key === 'Enter' && e.shiftKey) {
        setTimeout(adjustTextareaHeight, 0);
      }
    });

    sendBtn.addEventListener('click', sendMessage);

    async function sendMessage() {
      const message = chatInput.value.trim();
      if (!message) return;

      if (API_KEYS.length === 0) {
        showToast('No API keys configured', 'error');
        return;
      }

      if (!welcome.classList.contains('hidden')) {
        welcome.classList.add('hidden');
        messages.classList.remove('hidden');
      }

      addMessage(message, 'user');
      chatInput.value = '';
      resetTextareaHeight();

      attemptedKeysThisCycle = new Set();
      hasCheckedAllKeysThisCycle = false;

      sendBtn.disabled = true;
      stopBtn.classList.add('show');

      await getAIResponse(message);

      sendBtn.disabled = false;
      stopBtn.classList.remove('show');
      isStreamingResponse = false;
    }

    function addMessage(content, role) {
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${role}`;

      const avatarDiv = document.createElement('div');
      avatarDiv.className = 'message-avatar';
      avatarDiv.textContent = role === 'user' ? '👤' : '🤖';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';

      if (role === 'ai') {
        contentDiv.innerHTML = parseMarkdown(content);
      } else {
        contentDiv.textContent = content;
      }

      messageDiv.appendChild(avatarDiv);
      messageDiv.appendChild(contentDiv);

      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'message-actions';

      const copyBtn = document.createElement('button');
      copyBtn.className = 'action-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(content);
      });

      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'action-btn delete';
      deleteBtn.textContent = 'Delete';
      deleteBtn.addEventListener('click', () => {
        messageDiv.remove();
      });

      actionsDiv.appendChild(copyBtn);
      actionsDiv.appendChild(deleteBtn);
      messageDiv.appendChild(actionsDiv);

      messages.appendChild(messageDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function parseMarkdown(text) {
      let html = text;

      html = html.replace(/```([\s\S]*?)```/g, (match, code) => {
        const trimmedCode = code.trim();
        return `<div class="code-wrapper"><code>${escapeHtml(trimmedCode)}</code><button class="code-copy-button" onclick="copyCodeContent(this)">📋</button></div>`;
      });

      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');
      html = html.replace(/\n/g, '<br>');

      return html;
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    window.copyCodeContent = function(button) {
      const codeElement = button.parentElement.querySelector('code');
      const text = codeElement.textContent;
      navigator.clipboard.writeText(text);
    };

    async function getAIResponse(message) {
      isStreamingResponse = true;

      while (!hasCheckedAllKeysThisCycle && isStreamingResponse) {
        if (currentKeyIndex >= API_KEYS.length) {
          currentKeyIndex = 0;
        }

        const key = API_KEYS[currentKeyIndex];

        if (!key || key.trim() === '') {
          currentKeyIndex = (currentKeyIndex + 1) % API_KEYS.length;
          attemptedKeysThisCycle.add(currentKeyIndex);
          if (attemptedKeysThisCycle.size >= API_KEYS.length) {
            hasCheckedAllKeysThisCycle = true;
            showToast('All API keys are unavailable', 'error');
          }
          continue;
        }

        try {
          const systemPrompt = systemPromptInput.value || 'You are a helpful AI assistant.';
          const temperature = parseFloat(temperatureSlider.value);
          const maxTokens = parseInt(maxTokensInput.value);

          abortController = new AbortController();

          const response = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=' + key, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              systemInstruction: { parts: [{ text: systemPrompt }] },
              contents: {
                parts: [{ text: message }],
              },
              generationConfig: {
                temperature: temperature,
                maxOutputTokens: maxTokens,
              },
            }),
            signal: abortController.signal
          });

          if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            let errorType = 'unknown_error';

            if (response.status === 429) {
              errorType = 'quota_reached';
            } else if (response.status === 400 || response.status === 403) {
              errorType = 'invalid_key';
            }

            keyStatuses[currentKeyIndex] = errorType;
            updateKeyStatusDisplay(currentKeyIndex);
            attemptedKeysThisCycle.add(currentKeyIndex);

            if (attemptedKeysThisCycle.size >= API_KEYS.length) {
              hasCheckedAllKeysThisCycle = true;
              showToast('All API keys are unavailable', 'error');
            }

            currentKeyIndex = (currentKeyIndex + 1) % API_KEYS.length;
            saveCurrentKeyIndex();
            continue;
          }

          const data = await response.json();
          
          if (!data.candidates || !data.candidates[0] || !data.candidates[0].content || !data.candidates[0].content.parts || !data.candidates[0].content.parts[0] || !data.candidates[0].content.parts[0].text) {
            keyStatuses[currentKeyIndex] = 'unknown_error';
            updateKeyStatusDisplay(currentKeyIndex);
            attemptedKeysThisCycle.add(currentKeyIndex);

            if (attemptedKeysThisCycle.size >= API_KEYS.length) {
              hasCheckedAllKeysThisCycle = true;
              showToast('All API keys are unavailable', 'error');
            }

            currentKeyIndex = (currentKeyIndex + 1) % API_KEYS.length;
            saveCurrentKeyIndex();
            continue;
          }

          const aiMessage = data.candidates[0].content.parts[0].text;

          keyStatuses[currentKeyIndex] = 'active';
          updateKeyStatusDisplay(currentKeyIndex);
          addMessage(aiMessage, 'ai');
          hasCheckedAllKeysThisCycle = true;
          saveCurrentKeyIndex();

        } catch (error) {
          if (error.name === 'AbortError') {
            keyStatuses[currentKeyIndex] = 'unknown_error';
            updateKeyStatusDisplay(currentKeyIndex);
            hasCheckedAllKeysThisCycle = true;
            return;
          }

          keyStatuses[currentKeyIndex] = 'unknown_error';
          updateKeyStatusDisplay(currentKeyIndex);
          attemptedKeysThisCycle.add(currentKeyIndex);

          if (attemptedKeysThisCycle.size >= API_KEYS.length) {
            hasCheckedAllKeysThisCycle = true;
            showToast('All API keys are unavailable', 'error');
          }

          currentKeyIndex = (currentKeyIndex + 1) % API_KEYS.length;
          saveCurrentKeyIndex();
        }
      }
    }

    function updateKeyStatusDisplay(keyIndex) {
      const rows = apiKeysTable.querySelectorAll('tr');
      if (rows[keyIndex]) {
        const statusCell = rows[keyIndex].querySelector('td:last-child');
        if (statusCell) {
          const status = keyStatuses[keyIndex] || 'idle';
          let statusText = 'idle';
          let statusClass = '';

          if (status === 'active') {
            statusText = 'active';
            statusClass = 'active';
          } else if (status === 'quota_reached') {
            statusText = 'quota_reached';
            statusClass = 'error';
          } else if (status === 'invalid_key') {
            statusText = 'invalid_key';
            statusClass = 'error';
          } else if (status === 'unknown_error') {
            statusText = 'unknown_error';
            statusClass = 'error';
          }

          statusCell.innerHTML = `<span class="status-indicator ${statusClass}"></span>${statusText}`;
        }
      }
    }

    function renderApiKeyStatus() {
      apiKeysTable.innerHTML = '';
      API_KEYS.forEach((key, index) => {
        const row = document.createElement('tr');
        const status = keyStatuses[index] || 'idle';
        let statusText = 'idle';
        let statusClass = '';

        if (status === 'active') {
          statusText = 'active';
          statusClass = 'active';
        } else if (status === 'quota_reached') {
          statusText = 'quota_reached';
          statusClass = 'error';
        } else if (status === 'invalid_key') {
          statusText = 'invalid_key';
          statusClass = 'error';
        } else if (status === 'unknown_error') {
          statusText = 'unknown_error';
          statusClass = 'error';
        }

        row.innerHTML = `
          <td>API Key ${index + 1}</td>
          <td><span class="status-indicator ${statusClass}"></span>${statusText}</td>
        `;
        apiKeysTable.appendChild(row);
      });
    }

    function showToast(message, type = 'error') {
      toast.textContent = message;
      toast.className = `toast show ${type}`;
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    menuBtn.addEventListener('click', () => {
      settingsPanel.classList.add('open');
      settingsOverlay.classList.add('open');
    });

    closeSettingsBtn.addEventListener('click', closeSettings);
    settingsOverlay.addEventListener('click', closeSettings);

    function closeSettings() {
      settingsPanel.classList.remove('open');
      settingsOverlay.classList.remove('open');
    }

    temperatureSlider.addEventListener('input', () => {
      tempValue.textContent = temperatureSlider.value;
    });

    clearChatBtn.addEventListener('click', () => {
      messages.innerHTML = '';
      welcome.classList.remove('hidden');
      messages.classList.add('hidden');
    });

    presetsSelect.addEventListener('change', (e) => {
      const presetPrompts = {
        default: 'You are a helpful AI assistant.',
        teacher: 'You are a brilliant teacher. Explain concepts clearly and patiently.',
        developer: 'You are an expert software developer. Provide best practices and clean code.',
        engineer: 'You are a fact-driven engineer. Be precise and technical.',
        religion: 'You are a knowledgeable expert in religious studies.',
        creative: 'You are a creative visionary. Think outside the box.',
        professional: 'You are a professional advisor. Be concise and businesslike.',
        analyst: 'You are a data analyst. Focus on insights and patterns.',
        tutor: 'You are a patient tutor. Break down complex ideas simply.',
      };

      if (e.target.value !== 'none') {
        systemPromptInput.value = presetPrompts[e.target.value];
      }
    });

    function setInput(text) {
      chatInput.value = text;
      adjustTextareaHeight();
      chatInput.focus();
    }

    stopBtn.addEventListener('click', () => {
      isStreamingResponse = false;
      if (abortController) {
        abortController.abort();
      }
    });

    loadCurrentKeyIndex();
  </script>
</body>

</html>