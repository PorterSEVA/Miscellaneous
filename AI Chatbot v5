<!DOCTYPE html>
<!-- By Ion-o-koji -->
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>AI Chatbot v5</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg: #0b000a;
      --surface: #0a0a1a;
      --surface-elevated: #1a141a;
      --border: #1f1f1f;
      --text: #ffffff;
      --text-secondary: #888888;
      --accent: #8b5cf6;
      --accent-glow: rgba(139, 92, 246, 0.4);
      --user-bubble: #8b5cf6;
      --ai-bubble: #1f1f1f;
      --success: #22c55e;
      --danger: #dc2626;
    }

    html {
      height: -webkit-fill-available;
    }

    body {
      height: 100vh;
      height: 100dvh;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    .app {
      height: 100vh;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      max-width: 100%;
      margin: 0 auto;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .header-title {
      flex: 1;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
    }

    .menu-btn {
      width: 32px;
      height: 32px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    .menu-btn:hover {
      border-color: var(--accent);
      background: rgba(139, 92, 246, 0.1);
    }

    .settings-panel {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: 320px;
      background: var(--surface);
      border-left: 1px solid var(--border);
      z-index: 2000;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }

    .settings-panel.open {
      transform: translateX(0);
    }

    .settings-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      display: none;
    }

    .settings-overlay.open {
      display: block;
    }

    .settings-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .settings-header h2 {
      font-size: 18px;
      font-weight: 600;
    }

    .close-btn {
      width: 28px;
      height: 28px;
      background: transparent;
      border: none;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .close-btn:hover {
      color: var(--accent);
    }

    .settings-content {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
    }

    .setting-group {
      margin-bottom: 20px;
    }

    .setting-label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 8px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .setting-value {
      display: block;
      font-size: 14px;
      color: var(--text);
      margin-bottom: 8px;
      font-weight: 500;
    }

    .slider-input {
      width: 100%;
      height: 4px;
      border-radius: 2px;
      background: var(--border);
      outline: none;
      -webkit-appearance: none;
      appearance: none;
    }

    .slider-input::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      transition: background 0.2s;
    }

    .slider-input::-webkit-slider-thumb:hover {
      background: #a855f7;
    }

    .slider-input::-moz-range-thumb {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--accent);
      cursor: pointer;
      border: none;
      transition: background 0.2s;
    }

    .slider-input::-moz-range-thumb:hover {
      background: #a855f7;
    }

    .number-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
    }

    .number-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .textarea-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-family: inherit;
      resize: vertical;
      min-height: 80px;
      max-height: 150px;
    }

    .textarea-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .select-input {
      width: 100%;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      cursor: pointer;
    }

    .select-input:focus {
      outline: none;
      border-color: var(--accent);
    }

    .select-input option {
      background: var(--surface);
      color: var(--text);
    }

    .clear-btn {
      width: 100%;
      padding: 10px 16px;
      background: var(--danger);
      border: none;
      border-radius: 6px;
      color: white;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 10px;
    }

    .clear-btn:hover {
      background: #b91c1c;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, #8b5cf6, #a855f7);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    .logo-text {
      font-size: 16px;
      font-weight: 600;
    }

    .badge {
      font-size: 11px;
      padding: 4px 10px;
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
      border-radius: 20px;
      font-weight: 500;
    }

    .chat-container {
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      scroll-behavior: smooth;
    }

    .welcome {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      margin-top: 100px;
      align-items: center;
      min-height: 60vh;
      text-align: center;
      padding: 20px;
    }

    .welcome-icon {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, #8b5cf6, #a855f7);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin-bottom: 20px;
      box-shadow: 0 0 40px var(--accent-glow);
    }

    .welcome-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .welcome-subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 24px;
    }

    .suggestions {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      max-width: 320px;
    }

    .suggestion {
      padding: 12px 16px;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      margin: 5px;
    }

    .suggestion:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    .messages {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .message {
      display: flex;
      gap: 10px;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      flex-direction: row-reverse;
    }

    .message-avatar {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
    }

    .message.user .message-avatar {
      background: var(--user-bubble);
      align-self: flex-start;
    }

    .message.ai .message-avatar {
      background: var(--ai-bubble);
      border: 1px solid var(--border);
      align-self: flex-start;
    }

    .message-content {
      max-width: calc(100% - 40px);
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 14px;
      line-height: 1.5;
      word-wrap: break-word;
      position: relative;
      white-space: pre-wrap;
      padding-right: 45px;
    }

    .message.user .message-content {
      background: var(--user-bubble);
      border-bottom-right-radius: 4px;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content {
      background: var(--ai-bubble);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content pre {
      background: #0a0a0a;
      padding: 10px;
      border-radius: 6px;
      overflow-x: auto;
      margin: 8px 0;
      font-family: 'SF Mono', monospace;
      font-size: 12px;
      position: relative;
      -webkit-user-select: text;
      user-select: text;
    }

    .message.ai .message-content code {
      background: #0a0a0a;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: 'SF Mono', monospace;
      font-size: 12px;
    }

    .copy-button {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid var(--accent);
      color: var(--accent);
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s;
      z-index: 10;
      -webkit-user-select: none;
      user-select: none;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.7;
      flex-shrink: 0;
    }

    .copy-button:active {
      opacity: 1;
    }

    .code-wrapper {
      position: relative;
      background: #0a0a0a;
      border-radius: 6px;
      margin: 8px 0;
      padding: 10px;
      padding-top: 40px;
      overflow: hidden;
    }

    .code-wrapper code {
      display: block;
      overflow-x: auto;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .code-copy-button {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid var(--accent);
      color: var(--accent);
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s;
      z-index: 10;
      -webkit-user-select: none;
      user-select: none;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.7;
      flex-shrink: 0;
    }

    .code-copy-button:active {
      opacity: 1;
    }

    .message-actions {
      display: none;
      gap: 4px;
      position: absolute;
      bottom: -35px;
      left: 0;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 4px;
      z-index: 10;
      width: max-content;
    }

    .message:hover .message-actions {
      display: flex;
    }

    .message.user .message-actions {
      left: auto;
      right: 0;
    }

    .action-btn {
      background: transparent;
      border: none;
      color: var(--accent);
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      transition: all 0.2s;
      white-space: nowrap;
      -webkit-user-select: none;
      user-select: none;
    }

    .action-btn:active {
      background: rgba(139, 92, 246, 0.2);
    }

    .action-btn.delete {
      color: var(--danger);
    }

    .action-btn.delete:active {
      background: rgba(220, 38, 38, 0.2);
    }

    .typing {
      display: flex;
      gap: 3px;
      padding: 4px 0;
    }

    .typing-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      animation: bounce 1.4s infinite;
    }

    .typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes bounce {

      0%,
      60%,
      100% {
        transform: translateY(0);
      }

      30% {
        transform: translateY(-6px);
      }
    }

    .input-area {
      padding: 12px 16px;
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
      background: var(--surface);
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    .input-wrapper {
      display: flex;
      gap: 10px;
      align-items: flex-end;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 8px 8px 8px 16px;
    }

    .input-wrapper:focus-within {
      border-color: var(--accent);
    }

    .chat-input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 14px;
      resize: none;
      max-height: 100px;
      min-height: 20px;
      outline: none;
      font-family: inherit;
      padding: 4px 0;
      margin: auto 0;
      display: block;
      width: 100%;
    }

    .chat-input::placeholder {
      color: var(--text-secondary);
    }

    .button-group {
      display: flex;
      gap: 8px;
    }

    .send-btn,
    .stop-btn {
      width: 32px;
      height: 32px;
      border: none;
      border-radius: 50%;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    .send-btn {
      background: var(--accent);
    }

    .send-btn:active:not(:disabled) {
      background: #7c3aed;
      transform: scale(1.05);
    }

    .send-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .stop-btn {
      background: var(--danger);
      display: none;
    }

    .stop-btn.show {
      display: flex;
    }

    .stop-btn:active {
      background: #b91c1c;
      transform: scale(1.05);
    }

    .send-btn svg,
    .stop-btn svg {
      width: 16px;
      height: 16px;
    }

    .toast {
      position: fixed;
      bottom: 80px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #dc2626;
      color: white;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13px;
      opacity: 0;
      transition: all 0.3s;
      z-index: 1000;
      pointer-events: none;
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .toast.success {
      background: var(--success);
    }

    .api-keys-section {
      margin-top: 40px;
    }

    .api-keys-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }

    .api-keys-table tr {
      border-bottom: 1px solid var(--border);
    }

    .api-keys-table td {
      padding: 12px 8px;
      font-size: 12px;
    }

    .api-keys-table td:first-child {
      text-align: left;
      color: var(--text);
      font-weight: 500;
      width: 50%;
    }

    .api-keys-table td:last-child {
      text-align: left;
      color: var(--text-secondary);
      font-size: 11px;
      width: 50%;
    }

    .status-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--text-secondary);
      margin-right: 6px;
      vertical-align: middle;
    }

    .status-indicator.active {
      background: var(--success);
      box-shadow: 0 0 6px var(--success);
    }

    .status-indicator.error {
      background: var(--danger);
      box-shadow: 0 0 6px var(--danger);
    }

    @media (min-width: 768px) {
      body {
        background: #0a0a0a;
      }

      .app {
        max-width: 800px;
        left: 50%;
        transform: translateX(-50%);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
      }

      .send-btn:hover:not(:disabled) {
        background: #7c3aed;
        transform: scale(1.05);
      }

      .stop-btn:hover {
        background: #b91c1c;
        transform: scale(1.05);
      }

      .action-btn:hover {
        background: rgba(139, 92, 246, 0.2);
      }

      .action-btn.delete:hover {
        background: rgba(220, 38, 38, 0.2);
      }

      .copy-button:hover {
        opacity: 1;
      }

      .code-copy-button:hover {
        opacity: 1;
      }
    }

    .hidden {
      display: none !important;
    }

  </style>
</head>

<body>
  <div class="app">
    <header class="header">
      <div></div>
      <div class="header-title">Chat Assistant - Gemini</div>
      <button class="menu-btn" id="menuBtn" title="Settings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </header>

    <div class="chat-container" id="chatContainer">
      <div class="welcome" id="welcome">
        <h1 class="welcome-title">How can I help you?</h1>
        <div class="suggestions">
          <button class="suggestion" onclick="setInput('How do I fix this code in JavaScript: ')">
            How do I fix this code in JavaScript:
          </button>
          <button class="suggestion" onclick="setInput('In this code in JavaScript it wont * how do I fix it here is the code: ')">
            In this code in JavaScript it wont * how do I fix it:
          </button>
          <button class="suggestion" onclick="setInput('In JavaScript how do I ')">
            In JavaScript how do I
          </button>
          <button class="suggestion" onclick="setInput('In JavaScript how dose this work: ')">
            In JavaScript how dose this work:
          </button>
          <button class="suggestion" onclick="setInput('Translate this sentence into Khmer: ')">
            Translate this sentence into Khmer:
          </button>
          <button class="suggestion" onclick="setInput('Translate this sentence into English: ')">
            Translate this sentence into English:
          </button>
        </div>
      </div>
      <div class="messages hidden" id="messages"></div>
    </div>

    <div class="input-area">
      <div class="input-wrapper">
        <textarea class="chat-input" id="chatInput" placeholder="Message..." rows="1"></textarea>
        <div class="button-group">
          <button class="send-btn" id="sendBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
          </button>
          <button class="stop-btn" id="stopBtn" title="Stop">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="6" width="12" height="12"></rect>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="settings-overlay" id="settingsOverlay"></div>
  <div class="settings-panel" id="settingsPanel">
    <div class="settings-header">
      <h2>Settings</h2>
      <button class="close-btn" id="closeSettingsBtn">&times;</button>
    </div>
    <div class="settings-content">
      <div class="setting-group">
        <label class="setting-label">System Prompt</label>
        <textarea id="systemPrompt" class="textarea-input" placeholder="Enter system instructions for the AI..."></textarea>
      </div>

      <div class="setting-group">
        <label class="setting-label">Conversation Presets</label>
        <select id="presets" class="select-input">
          <option value="none">Select a preset...</option>
          <option value="default">Default Assistant</option>
          <option value="teacher">Brilliant Teacher</option>
          <option value="developer">Expert Developer</option>
          <option value="engineer">Fact-Driven Engineer</option>
          <option value="religion">Religious Expert</option>
          <option value="creative">Creative Visionary</option>
          <option value="professional">Professional Advisor</option>
          <option value="analyst">Data Analyst</option>
          <option value="tutor">Patient Tutor</option>
        </select>
      </div>

      <div class="setting-group">
        <label class="setting-label">Temperature</label>
        <div class="setting-value" id="tempValue">0.7</div>
        <input type="range" id="temperature" class="slider-input" min="0" max="2" step="0.1" value="0.7">
      </div>

      <div class="setting-group">
        <label class="setting-label">Max Output Tokens</label>
        <input type="number" id="maxTokens" class="number-input" min="256" max="8192" value="2048">
      </div>

      <button class="clear-btn" id="clearChatBtn">Clear All Messages</button>

      <div class="setting-group api-keys-section">
        <label class="setting-label">API Keys Management</label>
        <table class="api-keys-table" id="apiKeysTable">
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const chatContainer = document.getElementById('chatContainer');
    const welcome = document.getElementById('welcome');
    const messages = document.getElementById('messages');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const stopBtn = document.getElementById('stopBtn');
    const toast = document.getElementById('toast');
    const menuBtn = document.getElementById('menuBtn');
    const settingsPanel = document.getElementById('settingsPanel');
    const settingsOverlay = document.getElementById('settingsOverlay');
    const closeSettingsBtn = document.getElementById('closeSettingsBtn');
    const temperatureSlider = document.getElementById('temperature');
    const tempValue = document.getElementById('tempValue');
    const maxTokensInput = document.getElementById('maxTokens');
    const systemPromptInput = document.getElementById('systemPrompt');
    const presetsSelect = document.getElementById('presets');
    const clearChatBtn = document.getElementById('clearChatBtn');
    const apiKeysTable = document.getElementById('apiKeysTable').querySelector('tbody');

    let isGenerating = false;
    let conversation = [];
    let abortController = null;

    // API Key 1
    const API_KEY_1 = '';
    
    // API Key 2
    const API_KEY_2 = '';
    
    // API Key 3
    const API_KEY_3 = '';
    
    // API Key 4
    const API_KEY_4 = '';
    
    // API Key 5
    const API_KEY_5 = '';
    
    // API Key 6
    const API_KEY_6 = '';
    
    // API Key 7
    const API_KEY_7 = '';
    
    // API Key 8
    const API_KEY_8 = '';
    
    // API Key 9
    const API_KEY_9 = '';
    
    // API Key 10
    const API_KEY_10 = '';

    const API_KEYS = [API_KEY_1, API_KEY_2, API_KEY_3, API_KEY_4, API_KEY_5, API_KEY_6, API_KEY_7, API_KEY_8, API_KEY_9, API_KEY_10];

    // Error type detection
    function getErrorType(errorData, statusCode) {
      if (statusCode === 429) {
        return 'quota_exceeded';
      }
      
      const errorMessage = errorData?.error?.message || '';
      const errorCode = errorData?.error?.code || '';
      
      if (errorCode === 403 || errorMessage.toLowerCase().includes('disabled') || errorMessage.toLowerCase().includes('blocked')) {
        return 'key_disabled';
      }
      
      if (errorCode === 400 || errorMessage.toLowerCase().includes('invalid') || errorMessage.toLowerCase().includes('malformed')) {
        return 'invalid_key';
      }
      
      if (errorMessage.toLowerCase().includes('high demand') || errorMessage.toLowerCase().includes('resource_exhausted')) {
        return 'high_demand';
      }
      
      return 'unknown_error';
    }

    function getErrorMessage(errorType) {
      const messages = {
        quota_exceeded: 'Quota Exceeded',
        key_disabled: 'Key Disabled/Exposed',
        invalid_key: 'Invalid Key',
        high_demand: 'High Demand',
        unknown_error: 'Unknown Error'
      };
      return messages[errorType] || 'Unknown Error';
    }

    // API Key Management System
    const API_KEY_MANAGER = {
      keys: [],
      currentKeyIndex: 0,
      attemptedKeysIndices: new Set(),
      hasTriedAllKeys: false,

      init() {
        this.keys = API_KEYS.map((key, index) => ({
          index: index,
          key: key,
          status: 'idle',
          errorType: null
        })).filter(k => k.key && k.key.trim() !== '');
        
        if (this.keys.length === 0) {
          return;
        }

        this.currentKeyIndex = this.getLastUsedKeyIndex();
        this.attemptedKeysIndices = new Set();
        this.hasTriedAllKeys = false;
        this.updateUI();
      },

      getCurrentKey() {
        if (this.keys.length === 0) return '';
        return this.keys[this.currentKeyIndex]?.key || '';
      },

      getCurrentKeyIndex() {
        if (this.keys.length === 0) return -1;
        return this.keys[this.currentKeyIndex]?.index || 0;
      },

      markKeyAsActive(keyIndex) {
        const keyObj = this.keys.find(k => k.index === keyIndex);
        if (keyObj) {
          this.keys.forEach(k => k.status = 'idle');
          keyObj.status = 'active';
          keyObj.errorType = null;
          this.currentKeyIndex = this.keys.indexOf(keyObj);
          this.attemptedKeysIndices.clear();
          this.hasTriedAllKeys = false;
          localStorage.setItem('lastUsedKeyIndex', keyIndex.toString());
          this.updateUI();
        }
      },

      markKeyAsError(keyIndex, errorType) {
        const keyObj = this.keys.find(k => k.index === keyIndex);
        if (keyObj) {
          keyObj.status = 'error';
          keyObj.errorType = errorType;
          this.attemptedKeysIndices.add(keyObj.index);
          this.updateUI();
        }
      },

      switchToNextAvailableKey() {
        if (this.keys.length === 0) {
          return -1;
        }

        // Check if we've already tried all keys
        if (this.hasTriedAllKeys) {
          return -1;
        }

        // Check if we've tried all available keys in one cycle
        if (this.attemptedKeysIndices.size >= this.keys.length) {
          this.hasTriedAllKeys = true;
          return -1;
        }

        // Find next key that we haven't tried yet
        for (let i = 0; i < this.keys.length; i++) {
          const nextIndex = (this.currentKeyIndex + 1 + i) % this.keys.length;
          const keyObj = this.keys[nextIndex];
          
          if (!this.attemptedKeysIndices.has(keyObj.index)) {
            this.currentKeyIndex = nextIndex;
            this.attemptedKeysIndices.add(keyObj.index);
            this.markKeyAsError(keyObj.index, 'unknown_error');
            return keyObj.index;
          }
        }

        this.hasTriedAllKeys = true;
        return -1;
      },

      resetForNewMessage() {
        this.attemptedKeysIndices.clear();
        this.hasTriedAllKeys = false;
        // Mark current key as having attempted
        this.attemptedKeysIndices.add(this.getCurrentKeyIndex());
      },

      getLastUsedKeyIndex() {
        const saved = localStorage.getItem('lastUsedKeyIndex');
        if (saved && this.keys.length > 0) {
          const index = parseInt(saved);
          const keyObj = this.keys.find(k => k.index === index);
          if (keyObj) {
            return this.keys.indexOf(keyObj);
          }
        }
        return 0;
      },

      updateUI() {
        apiKeysTable.innerHTML = '';
        this.keys.forEach((keyData) => {
          const row = document.createElement('tr');
          
          const keyCell = document.createElement('td');
          const statusIndicator = document.createElement('div');
          statusIndicator.className = 'status-indicator';
          if (keyData.status === 'active') {
            statusIndicator.classList.add('active');
          } else if (keyData.status === 'error') {
            statusIndicator.classList.add('error');
          }
          
          keyCell.appendChild(statusIndicator);
          keyCell.appendChild(document.createTextNode(`API Key ${keyData.index + 1}`));
          
          const statusCell = document.createElement('td');
          if (keyData.status === 'active') {
            statusCell.textContent = 'Active';
          } else if (keyData.status === 'error' && keyData.errorType) {
            statusCell.textContent = getErrorMessage(keyData.errorType);
          } else if (keyData.status === 'error') {
            statusCell.textContent = 'Error';
          } else {
            statusCell.textContent = 'Idle';
          }
          
          row.appendChild(keyCell);
          row.appendChild(statusCell);
          apiKeysTable.appendChild(row);
        });
      }
    };

    // Conversation Presets
    const PRESETS = {
      default: {
        name: 'Default Assistant',
        systemPrompt: 'You are a helpful AI assistant. Provide clear, accurate, and concise answers to the user\'s questions.'
      },
      teacher: {
        name: 'Brilliant Teacher',
        systemPrompt: `You are an exceptional and patient educator with the ability to explain complex concepts in simple, engaging ways. Your teaching style includes:
- Breaking down difficult topics into digestible parts
- Using real-world examples and analogies
- Asking questions to check understanding
- Encouraging curiosity and deeper learning
- Providing step-by-step guidance
- Adapting explanations to different learning styles
Always prioritize clarity and engagement over technical jargon. Make learning enjoyable and intuitive.`
      },
      developer: {
        name: 'Expert Developer',
        systemPrompt: `You are a senior software engineer with 15+ years of experience across multiple languages and frameworks. Your expertise includes:
- Writing clean, efficient, production-ready code
- Following SOLID principles and design patterns
- Optimizing for performance and scalability
- Security best practices and vulnerability prevention
- Code review and best practices
- Architecture and system design
- Debugging and troubleshooting
Be pragmatic, direct, and focus on practical solutions. Provide code examples when relevant. Consider edge cases and potential issues.`
      },
      engineer: {
        name: 'Fact-Driven Engineer',
        systemPrompt: `You are a rigorous engineer who values evidence, data, and empirical observation. Your approach includes:
- Basing solutions on verified research and proven methodologies
- Distinguishing between facts, assumptions, and specifications
- Explaining technical reasoning and engineering principles
- Acknowledging limitations and tolerances
- Correcting misconceptions with evidence
- Explaining complex engineering concepts accurately
- Being precise with measurements and standards
Always base responses on verified technical data and engineering best practices. Be precise with terminology and explain your reasoning clearly.`
      },
      religion: {
        name: 'Religious Expert',
        systemPrompt: `You are a knowledgeable and respectful expert on world religions and spirituality. Your approach includes:
- Speaking with respect and reverence about all faiths
- Providing accurate historical and theological information
- Acknowledging the diversity within religions
- Explaining beliefs, practices, and traditions clearly
- Being courteous and non-judgmental toward all traditions
- Recognizing the spiritual significance to believers
- Contextualizing religious concepts appropriately
- Encouraging interfaith understanding and dialogue
Always maintain respect for all religions and spiritual traditions. Be inclusive, accurate, and promote understanding between different faiths.`
      },
      creative: {
        name: 'Creative Visionary',
        systemPrompt: `You are a highly creative thinker who challenges conventional wisdom and explores innovative possibilities. Your approach includes:
- Thinking outside the box and considering unconventional solutions
- Encouraging experimentation and taking calculated risks
- Building on ideas without immediately dismissing them
- Using metaphors, analogies, and thought experiments
- Exploring multiple perspectives and "what-if" scenarios
- Brainstorming and ideation
- Combining ideas in novel ways
Embrace creativity, imagination, and novel approaches. Encourage bold thinking while remaining thoughtful about feasibility.`
      },
      professional: {
        name: 'Professional Advisor',
        systemPrompt: `You are a seasoned business professional and consultant with expertise across industries. Your approach includes:
- Providing strategic and tactical advice
- Focusing on ROI, efficiency, and outcomes
- Understanding market dynamics and competition
- Offering leadership and management insights
- Considering business implications and risks
- Being concise and results-oriented
- Recommending actionable next steps
Provide pragmatic, business-focused guidance. Be direct and focus on tangible results and impact.`
      },
      analyst: {
        name: 'Data Analyst',
        systemPrompt: `You are an expert data analyst skilled in statistical analysis, data interpretation, and insights discovery. Your approach includes:
- Asking clarifying questions about data context
- Explaining statistical concepts clearly
- Identifying patterns, trends, and anomalies
- Recommending appropriate analytical methods
- Discussing data limitations and confidence levels
- Providing actionable insights from data
- Suggesting visualization approaches
Focus on accurate, evidence-based analysis. Question assumptions and help interpret results properly.`
      },
      tutor: {
        name: 'Patient Tutor',
        systemPrompt: `You are a dedicated tutor known for infinite patience and ability to meet students where they are. Your approach includes:
- Meeting learners at their level of understanding
- Providing encouragement and positive reinforcement
- Taking time to explain repeatedly without frustration
- Using varied examples and practice problems
- Identifying knowledge gaps and addressing them
- Celebrating progress and effort
- Customizing explanations to individual needs
Be warm, encouraging, and never condescending. Adapt your pace and explanations based on understanding shown.`
      }
    };

    // Settings defaults
    const DEFAULT_SETTINGS = {
      temperature: 0.7,
      maxTokens: 2048,
      systemPrompt: ''
    };

    // Load settings from localStorage
    function loadSettings() {
      const saved = localStorage.getItem('chatbotSettings');
      if (saved) {
        const settings = JSON.parse(saved);
        temperatureSlider.value = settings.temperature || DEFAULT_SETTINGS.temperature;
        maxTokensInput.value = settings.maxTokens || DEFAULT_SETTINGS.maxTokens;
        systemPromptInput.value = settings.systemPrompt || DEFAULT_SETTINGS.systemPrompt;
        updateTempDisplay();
      }
    }

    // Save settings to localStorage
    function saveSettings() {
      const settings = {
        temperature: parseFloat(temperatureSlider.value),
        maxTokens: parseInt(maxTokensInput.value),
        systemPrompt: systemPromptInput.value
      };
      localStorage.setItem('chatbotSettings', JSON.stringify(settings));
    }

    function updateTempDisplay() {
      tempValue.textContent = temperatureSlider.value;
    }

    // Settings Panel Controls
    menuBtn.addEventListener('click', () => {
      settingsPanel.classList.add('open');
      settingsOverlay.classList.add('open');
    });

    closeSettingsBtn.addEventListener('click', () => {
      settingsPanel.classList.remove('open');
      settingsOverlay.classList.remove('open');
      saveSettings();
    });

    settingsOverlay.addEventListener('click', () => {
      settingsPanel.classList.remove('open');
      settingsOverlay.classList.remove('open');
      saveSettings();
    });

    temperatureSlider.addEventListener('input', updateTempDisplay);

    clearChatBtn.addEventListener('click', () => {
      if (confirm('Are you sure you want to clear all messages?')) {
        conversation = [];
        messages.innerHTML = '';
        messages.classList.add('hidden');
        welcome.classList.remove('hidden');
        chatContainer.scrollTop = 0;
        showToast('Conversation cleared', true);
      }
    });

    presetsSelect.addEventListener('change', (e) => {
      if (e.target.value !== 'none' && PRESETS[e.target.value]) {
        systemPromptInput.value = PRESETS[e.target.value].systemPrompt;
        saveSettings();
      }
    });

    // Copy to clipboard function (GitHub method)
    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);

      } catch (err) {
        console.log('Clipboard API failed, using fallback method');
        fallbackCopyToClipboard(text);
      }
    }

    // Fallback copy method
    function fallbackCopyToClipboard(text) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      textarea.style.pointerEvents = 'none';

      document.body.appendChild(textarea);
      textarea.select();

      try {
        document.execCommand('copy');

      } catch (err) {
        console.error('Copy failed:', err);
      } finally {
        document.body.removeChild(textarea);
      }
    }

    // Auto-resize textarea and reset after send
    function resizeTextarea() {
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 100) + 'px';
    }

    function resetTextarea() {
      chatInput.value = '';
      chatInput.style.height = 'auto';
      chatInput.style.height = '20px';
    }

    // Message Display Functions
    function addMessage(content, isUser = false) {
      if (!messages.classList.contains('hidden') === false) {
        messages.classList.remove('hidden');
        welcome.classList.add('hidden');
      }

      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${isUser ? 'user' : 'ai'}`;

      const avatar = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.textContent = isUser ? '👤' : '🤖';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.textContent = content;

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-button';
      copyBtn.textContent = '📋';
      copyBtn.addEventListener('click', async () => {
        await copyToClipboard(content);
      });
      contentDiv.appendChild(copyBtn);

      messageDiv.appendChild(avatar);
      messageDiv.appendChild(contentDiv);

      // Add message actions (delete button)
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'message-actions';

      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'action-btn delete';
      deleteBtn.textContent = '🗑️ Delete';
      deleteBtn.addEventListener('click', () => {
        const index = Array.from(messages.children).indexOf(messageDiv);
        if (index > -1) {
          messages.removeChild(messageDiv);
          conversation.splice(index, 1);
        }
      });

      actionsDiv.appendChild(deleteBtn);
      messageDiv.appendChild(actionsDiv);

      messages.appendChild(messageDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function formatContent(content) {
      let html = content
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/```([\s\S]*?)```/g, (match, code) => {
          const language = code.split('\n')[0].trim();
          const actualCode = code.replace(/^[^\n]*\n/, '');
          const codeId = 'code-' + Math.random().toString(36).substr(2, 9);
          return `<div class="code-wrapper" id="${codeId}"><button class="code-copy-button" data-target="${codeId}">📋</button><code>${actualCode}</code></div>`;
        })
        .replace(/`([^`]+)`/g, '<code>$1</code>');

      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = html;

      // Handle code block copy buttons
      tempDiv.querySelectorAll('.code-copy-button[data-target]').forEach(btn => {
        btn.addEventListener('click', async function () {
          const codeId = this.getAttribute('data-target');
          const codeBlock = document.getElementById(codeId);
          if (codeBlock) {
            const textToCopy = codeBlock.querySelector('code').innerText;
            await copyToClipboard(textToCopy);
          }
        });
      });

      return tempDiv.innerHTML;
    }

    function addAIMessage(content) {
      if (!messages.classList.contains('hidden') === false) {
        messages.classList.remove('hidden');
        welcome.classList.add('hidden');
      }

      const messageDiv = document.createElement('div');
      messageDiv.className = 'message ai';

      const avatar = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.textContent = '🤖';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.innerHTML = formatContent(content);

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-button';
      copyBtn.textContent = '📋';
      copyBtn.addEventListener('click', async () => {
        await copyToClipboard(content);
      });
      contentDiv.appendChild(copyBtn);

      messageDiv.appendChild(avatar);
      messageDiv.appendChild(contentDiv);

      // Add message actions (delete button)
      const actionsDiv = document.createElement('div');
      actionsDiv.className = 'message-actions';

      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'action-btn delete';
      deleteBtn.textContent = '🗑️ Delete';
      deleteBtn.addEventListener('click', () => {
        const index = Array.from(messages.children).indexOf(messageDiv);
        if (index > -1) {
          messages.removeChild(messageDiv);
          conversation.splice(index, 1);
        }
      });

      actionsDiv.appendChild(deleteBtn);
      messageDiv.appendChild(actionsDiv);

      messages.appendChild(messageDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function showTypingIndicator() {
      const messageDiv = document.createElement('div');
      messageDiv.className = 'message ai';
      messageDiv.id = 'typing-indicator';

      const avatar = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.textContent = '🤖';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.innerHTML = '<div class="typing"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';

      messageDiv.appendChild(avatar);
      messageDiv.appendChild(contentDiv);
      messages.appendChild(messageDiv);
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function removeTypingIndicator() {
      const typing = document.getElementById('typing-indicator');
      if (typing) {
        typing.remove();
      }
    }

    function showToast(message, isSuccess = false) {
      toast.textContent = message;
      toast.className = `toast show ${isSuccess ? 'success' : ''}`;
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    function setInput(text) {
      chatInput.value = text;
      resizeTextarea();
      chatInput.focus();
    }

    // API Request with Key Fallback
    async function sendMessage() {
      const userMessage = chatInput.value.trim();
      if (!userMessage || isGenerating) return;

      if (!API_KEY_MANAGER.getCurrentKey()) {
        showToast('Please configure at least one API key in the code');
        return;
      }

      isGenerating = true;
      resetTextarea();
      sendBtn.disabled = true;
      stopBtn.classList.add('show');
      addMessage(userMessage, true);
      showTypingIndicator();

      conversation.push({
        role: 'user',
        parts: [{ text: userMessage }]
      });

      API_KEY_MANAGER.resetForNewMessage();

      let lastError = null;
      let successfulKeyIndex = -1;

      // Try each key, but only once through all keys
      while (!API_KEY_MANAGER.hasTriedAllKeys) {
        const currentKey = API_KEY_MANAGER.getCurrentKey();
        if (!currentKey) {
          lastError = 'All keys not available';
          break;
        }

        try {
          abortController = new AbortController();
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=${currentKey}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              contents: conversation,
              generationConfig: {
                temperature: parseFloat(temperatureSlider.value),
                maxOutputTokens: parseInt(maxTokensInput.value)
              },
              systemInstruction: {
                parts: [{ text: systemPromptInput.value || PRESETS.default.systemPrompt }]
              }
            }),
            signal: abortController.signal
          });

          if (!response.ok) {
            const errorData = await response.json();
            const errorType = getErrorType(errorData, response.status);

            API_KEY_MANAGER.markKeyAsError(API_KEY_MANAGER.getCurrentKeyIndex(), errorType);
            const nextKeyIndex = API_KEY_MANAGER.switchToNextAvailableKey();
            
            if (nextKeyIndex === -1) {
              // All keys have been tried
              lastError = 'All keys not available';
              // Reset to Key 1
              API_KEY_MANAGER.keys.forEach(k => k.status = 'idle');
              API_KEY_MANAGER.currentKeyIndex = 0;
              if (API_KEY_MANAGER.keys.length > 0) {
                API_KEY_MANAGER.keys[0].status = 'idle';
              }
              API_KEY_MANAGER.updateUI();
              break;
            }
            
            showToast(`${getErrorMessage(errorType)}, trying next key...`);
            continue;
          }

          const data = await response.json();
          if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
            const aiResponse = data.candidates[0].content.parts[0].text;
            API_KEY_MANAGER.markKeyAsActive(API_KEY_MANAGER.getCurrentKeyIndex());
            removeTypingIndicator();
            addAIMessage(aiResponse);
            conversation.push({
              role: 'model',
              parts: [{ text: aiResponse }]
            });
            successfulKeyIndex = API_KEY_MANAGER.getCurrentKeyIndex();
            break;
          } else {
            lastError = 'Invalid response format from API';
            break;
          }
        } catch (error) {
          if (error.name === 'AbortError') {
            lastError = 'Request cancelled';
            break;
          }
          lastError = error.message;
          API_KEY_MANAGER.markKeyAsError(API_KEY_MANAGER.getCurrentKeyIndex(), 'unknown_error');
          const nextKeyIndex = API_KEY_MANAGER.switchToNextAvailableKey();
          if (nextKeyIndex === -1) {
            lastError = 'All keys not available';
            // Reset to Key 1
            API_KEY_MANAGER.keys.forEach(k => k.status = 'idle');
            API_KEY_MANAGER.currentKeyIndex = 0;
            if (API_KEY_MANAGER.keys.length > 0) {
              API_KEY_MANAGER.keys[0].status = 'idle';
            }
            API_KEY_MANAGER.updateUI();
            break;
          }
          showToast(`Error occurred, trying next key...`);
          continue;
        }
      }

      if (lastError && successfulKeyIndex === -1) {
        removeTypingIndicator();
        addAIMessage(`I encountered an error: ${lastError}`);
        showToast(lastError);
      }

      isGenerating = false;
      sendBtn.disabled = false;
      stopBtn.classList.remove('show');
    }

    // Event Listeners
    sendBtn.addEventListener('click', sendMessage);
    stopBtn.addEventListener('click', () => {
      if (abortController) {
        abortController.abort();
        removeTypingIndicator();
        isGenerating = false;
        sendBtn.disabled = false;
        stopBtn.classList.remove('show');
        showToast('Request stopped');
      }
    });

    chatInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    chatInput.addEventListener('input', resizeTextarea);

    // Initialize
    API_KEY_MANAGER.init();
    loadSettings();
  </script>
